# --- Secrets / environment ---
# Real secrets live in .env and must never be committed. The tracked template
# is .env.example (placeholders only).
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# --- Virtual environments ---
.venv/
venv/
env/

# --- Tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Cloud Run production secrets
cloudrun.env.yaml

# --- Uploaded / runtime media ---
media/

# --- OS / editor ---
.DS_Store
Thumbs.db
