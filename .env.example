ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/DATABASE_NAME
CORS_ORIGINS=["http://localhost:3000"]
JWT_SECRET_KEY=generate-a-long-random-secret
AUTH_COOKIE_SECURE=false

# Payments (Razorpay). Use test-mode keys in development.
PAYMENT_PROVIDER=razorpay
PAYMENT_CURRENCY=INR
HOLD_EXPIRY_MINUTES=10
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set to the "Secret" you configure on the Razorpay webhook (Dashboard → Webhooks).
RAZORPAY_WEBHOOK_SECRET=

# Notifications. "console" logs messages; "whatsapp" sends via Meta Cloud API.
NOTIFICATION_PROVIDER=console
# Meta WhatsApp Cloud API (Meta for Developers → WhatsApp → API Setup).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Prepended to bare 10-digit local numbers so WhatsApp gets full international
# form (e.g. "91" for India). Set "" to disable.
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# ElevenLabs account API key — lets the site connect to a PRIVATE voice agent
# (mints a per-conversation WebRTC token server-side).
ELEVENLABS_API_KEY=

# Patient phone OTP. "console" logs the code instead of sending an SMS (dev).
OTP_PROVIDER=console
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5

