ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/DATABASE_NAME
CORS_ORIGINS=["http://localhost:3000"]
JWT_SECRET_KEY=generate-a-long-random-secret
AUTH_COOKIE_SECURE=false

# Payments (Razorpay). Use test-mode keys in development.
PAYMENT_PROVIDER=razorpay
PAYMENT_CURRENCY=INR
HOLD_EXPIRY_MINUTES=10
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set to the "Secret" you configure on the Razorpay webhook (Dashboard → Webhooks).
RAZORPAY_WEBHOOK_SECRET=

# Notifications. "console" logs messages; "whatsapp" sends via Meta Cloud API.
NOTIFICATION_PROVIDER=console
# Meta WhatsApp Cloud API (Meta for Developers → WhatsApp → API Setup).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Prepended to bare 10-digit local numbers so WhatsApp gets full international
# form (e.g. "91" for India). Set "" to disable.
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# MSG91 WhatsApp (WABA). Sends pre-approved TEMPLATES rather than free-form
# text, which is what Meta requires for business-initiated messages — set
# NOTIFICATION_PROVIDER=msg91_whatsapp. This is a separate MSG91 account from
# the SMS/OTP one, hence its own authkey. Template names must match the ones
# approved in the MSG91 panel; variable order must match {{1}}..{{n}}.
MSG91_WA_AUTHKEY=
MSG91_WA_INTEGRATED_NUMBER=
MSG91_WA_NAMESPACE=
MSG91_WA_LANGUAGE=en
MSG91_WA_DEFAULT_COUNTRY_CODE=91
MSG91_WA_TEMPLATE_APPOINTMENT_CONFIRMED=appointment_confirmed
MSG91_WA_TEMPLATE_PAYMENT_LINK=payment_link
MSG91_WA_TEMPLATE_REVIEW_LINK=review_link

# ElevenLabs account API key — lets the site connect to a PRIVATE voice agent
# (mints a per-conversation WebRTC token server-side).
ELEVENLABS_API_KEY=

# Patient phone OTP. "console" logs the code instead of sending an SMS (dev);
# "msg91" delivers it via the MSG91 gateway.
OTP_PROVIDER=console
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5

# MSG91 SMS gateway (fill these and set OTP_PROVIDER=msg91 to send real OTP SMS).
# MSG91_OTP_TEMPLATE_ID is a *flow* template id (24-char ObjectId) — we post to
# the flow API, not the OTP API. MSG91_OTP_VARIABLE is the placeholder name in
# that DLT template (e.g. "var" for ##var##).
MSG91_AUTHKEY=
MSG91_SENDER_ID=
MSG91_OTP_TEMPLATE_ID=
MSG91_OTP_VARIABLE=var
MSG91_DEFAULT_COUNTRY_CODE=91


# Media storage: "local" writes to disk (development only — a Cloud Run
# filesystem is ephemeral and per-instance, so uploads are lost on deploy);
# "gcs" writes to a publicly-readable bucket.
MEDIA_STORAGE_PROVIDER=local
GCS_BUCKET=
# Optional CDN/custom domain in front of the bucket. Empty serves from
# storage.googleapis.com directly.
GCS_PUBLIC_BASE_URL=

# In-process APScheduler. MUST be false on Cloud Run (frozen CPU between
# requests; N instances race the daily job) — use Cloud Scheduler against
# /internal/jobs/* instead.
SCHEDULER_ENABLED=true
# Shared secret for /internal/jobs/*. Empty disables those endpoints entirely.
INTERNAL_JOB_TOKEN=

# Per-phone OTP send caps. Database-backed, so they hold across instances and
# cannot be reset by rotating IPs (which is what makes SMS bombing possible).
OTP_MAX_PER_PHONE_HOUR=5
OTP_MAX_PER_PHONE_DAY=15
